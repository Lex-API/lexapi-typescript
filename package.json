{
  "name": "@lexapi/client",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for LexAPI - EU legislation, CJEU case law and the Official Journal, parsed to article level.",
  "license": "MIT",
  "author": "Arieta Labs Ltd <support@lex-api.com> (https://lex-api.com)",
  "homepage": "https://lex-api.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lex-API/lexapi-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Lex-API/lexapi-typescript/issues"
  },
  "keywords": [
    "eur-lex",
    "eu",
    "legal",
    "law",
    "cjeu",
    "official-journal",
    "celex",
    "api",
    "sdk",
    "lexapi"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:dist": "node scripts/smoke-dist.mjs && node scripts/smoke-dist.cjs",
    "prepublishOnly": "npm run lint && npm test && npm run build && npm run smoke:dist"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
