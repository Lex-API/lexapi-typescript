{
  "name": "@lexapi/client",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for LexAPI - European legal data, made queryable.",
  "license": "MIT",
  "homepage": "https://lex-api.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lex-API/lexapi-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Lex-API/lexapi-typescript/issues"
  },
  "keywords": [
    "eur-lex",
    "eu",
    "legal",
    "law",
    "api",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
